<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Budget Alert - Fintrack</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
        background-color: #f4f4f5;
        color: #3f3f46;
        margin: 0;
        padding: 0;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .wrapper {
        background-color: #f4f4f5;
        padding: 40px 20px;
      }

      .container {
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e4e4e7;
      }

      .header {
        padding: 40px 40px 28px 40px;
        text-align: center;
        border-bottom: 1px solid #e4e4e7;
      }



      .hero-title {
        font-size: 22px;
        font-weight: 700;
        color: #18181b;
        letter-spacing: -0.02em;
        margin: 0 0 10px 0;
        line-height: 1.3;
      }

      .hero-subtitle {
        font-size: 14px;
        color: #71717a;
        margin: 0;
      }

      .content {
        padding: 32px 40px 40px 40px;
      }

      .greeting {
        font-size: 16px;
        font-weight: 600;
        color: #18181b;
        margin: 0 0 8px 0;
      }

      .intro {
        font-size: 14px;
        color: #52525b;
        margin: 0 0 24px 0;
      }

      .badge {
        display: inline-block;
        padding: 4px 12px;
        background-color: #fef3c7;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        color: #92400e;
        margin-bottom: 20px;
      }

      .transaction-list {
        margin: 0 0 24px 0;
        border: 1px solid #e4e4e7;
      }

      .transaction-item {
        padding: 16px;
        border-bottom: 1px solid #e4e4e7;
      }

      .transaction-item:last-child {
        border-bottom: none;
      }

      .transaction-item:nth-child(even) {
        background-color: #fafafa;
      }

      .tx-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
      }

      .tx-name {
        font-size: 14px;
        font-weight: 600;
        color: #18181b;
        margin: 0 0 2px 0;
      }

      .tx-meta {
        font-size: 12px;
        color: #71717a;
      }

      .tx-percentage {
        font-size: 15px;
        font-weight: 700;
        white-space: nowrap;
        padding-left: 12px;
      }

      .tx-percentage.over-budget {
        color: #dc2626;
      }

      .tx-percentage.near-limit {
        color: #d97706;
      }

      .progress-track {
        height: 6px;
        background-color: #e4e4e7;
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 6px;
      }

      .progress-bar {
        height: 100%;
        border-radius: 999px;
        max-width: 100%;
      }

      .progress-bar.over-budget {
        background-color: #dc2626;
      }

      .progress-bar.near-limit {
        background-color: #f59e0b;
      }

      .tx-amounts {
        font-size: 12px;
        color: #71717a;
      }

      .cta-block {
        text-align: center;
        margin: 8px 0 24px 0;
      }

      .cta-button {
        display: inline-block;
        padding: 12px 28px;
        background-color: #18181b;
        color: #ffffff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        border-radius: 6px;
        letter-spacing: 0.01em;
      }

      .note {
        font-size: 13px;
        color: #71717a;
        background-color: #f4f4f5;
        border-left: 3px solid #f59e0b;
        padding: 12px 16px;
        margin: 0 0 8px 0;
      }

      .footer {
        padding: 28px 40px;
        text-align: center;
        border-top: 1px solid #e4e4e7;
        background-color: #fafafa;
      }

      .footer-text {
        font-size: 13px;
        color: #71717a;
        margin: 0 0 12px 0;
      }

      .social-links {
        margin-bottom: 16px;
      }

      .social-links a {
        color: #7c7aff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        margin: 0 10px;
      }

      .legal {
        font-size: 11px;
        color: #a1a1aa;
        margin: 0;
        line-height: 1.7;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <div class='container'>
        <div class='header'>
          <table cellpadding="0" cellspacing="0" border="0" style="display: inline-table; margin-bottom: 20px;">
            <tr>
              <td style="background-color: #7c7aff; border-radius: 10px; width: 40px; height: 40px; text-align: center; vertical-align: middle; padding: 0;">
                <img src="cid:fintrack-logo" width="22" height="22" alt="" style="display:block; margin: 9px auto;" />
              </td>
              <td style="padding-left: 10px; vertical-align: middle;">
                <span style="font-size: 17px; font-weight: 700; color: #18181b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; letter-spacing: -0.02em; white-space: nowrap;">FinTrack</span>
              </td>
            </tr>
          </table>
          <h1 class='hero-title'>Budget Alert</h1>
          <p class='hero-subtitle'>One or more of your budgets has reached
            the alert threshold.</p>
        </div>

        <div class='content'>
          <p class='greeting'>Hi {{firstName}},</p>
          <p class='intro'>
            The following
            {{count}}
            {{#if (eq count 1)}}budget has{{else}}budgets have{{/if}}
            reached or exceeded your alert threshold:
          </p>

          <div class='badge'>
            {{count}}
            {{#if (eq count 1)}}budget{{else}}budgets{{/if}}
            need{{#if (eq count 1)}}s{{/if}}
            attention
          </div>

          <div class='transaction-list'>
            {{#each alerts}}
              <div class='transaction-item'>
                <div class='tx-header'>
                  <div>
                    <p class='tx-name'>{{this.categoryName}}</p>
                    <span class='tx-meta'>{{this.budgetName}}</span>
                  </div>
                  <div
                    class='tx-percentage {{#if this.isOverBudget}}over-budget{{else}}near-limit{{/if}}'
                  >
                    {{this.percentage}}%
                  </div>
                </div>
                <div class='progress-track'>
                  <div
                    class='progress-bar {{#if this.isOverBudget}}over-budget{{else}}near-limit{{/if}}'
                    style='width: {{this.percentage}}%;'
                  ></div>
                </div>
                <div class='tx-amounts'>
                  {{this.spentFormatted}} spent of {{this.limitFormatted}} limit
                </div>
              </div>
            {{/each}}
          </div>

          <p class='note'>
            You're receiving this alert because your spending has crossed the
            threshold you set. Adjust your budget or spending from your
            Fintrack dashboard.
          </p>

          <div class='cta-block'>
            <a
              href='https://www.fintrack.live/finances/budgets'
              class='cta-button'
            >View Budgets</a>
          </div>
        </div>

        <div class='footer'>
          <p class='footer-text'>The only financial tool you'll ever need.</p>
          <div class='social-links'>
            <a href='https://www.fintrack.live/support'>Support</a>
            <a href='https://www.fintrack.live/community'>Community</a>
          </div>
          <p class='legal'>
            &copy; 2026 Fintrack Inc. All rights reserved.<br />
            You're receiving this because you have budget alerts enabled.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
