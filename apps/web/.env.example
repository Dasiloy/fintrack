# =============================================================================
# Web App (Next.js) — Local Environment Variables Template
#
# These vars are specific to the Next.js web application.
# Shared vars (AUTH_SECRET, AUTH_GOOGLE_ID/SECRET, API_GATEWAY_URL, etc.)
# live in the root .env file and are automatically available here.
#
# Setup:
#   cp apps/web/.env.example apps/web/.env
# =============================================================================


# ── NextAuth ──────────────────────────────────────────────────────────────────
# Base URL NextAuth uses to build callback/redirect URLs.
# Must exactly match the URL you access the app from in the browser.
NEXTAUTH_URL=http://localhost:3000


# ── Public App URL ────────────────────────────────────────────────────────────
# Used by client-side code to build absolute URLs (e.g. share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Google Analytics ──────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID.
# Google Analytics: https://analytics.google.com
#   Admin → Data Streams → Web → Measurement ID (format: G-XXXXXXXXXX)
# Leave as G-XXXXXXXXXX to disable analytics in development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
# Cloudflare dashboard → Turnstile → Add site → get Site Key + Secret Key.
# For local dev use Cloudflare's test keys (always pass):
#   Site key:   1x00000000000000000000AA
#   Secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key


# ── Device Fingerprinting Cookie ─────────────────────────────────────────────
# Name of the cookie used to store the device fingerprint / device ID.
NEXT_PUBLIC_DEVICE_ID_COOKIE_NAME=x-device-id

# Max age of the device ID cookie in seconds (31536000 = 1 year).
DEVICE_ID_COOKIE_MAX_AGE=31536000

# ── Pricing ───────────────────────────────────────────────────────────────────
# Pro plan monthly price in Nigerian Naira displayed on the pricing page.
NEXT_PUBLIC_PRO_MONTHLY_PRICE_NGN=2500

# ── Support Email ─────────────────────────────────────────────────────────────
# Displayed on the contact, privacy, and terms pages.
NEXT_PUBLIC_FINTRACK_SUPPORT_EMAIL=support@fintrack.live

# ── Firebase VAPID Key ────────────────────────────────────────────────────────
# VAPID key for Firebase Messaging.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=Your VAPID key here

# Max DB connections for server-side tRPC caller (Aiven free tier total: 16)
DB_POOL_MAX=1
